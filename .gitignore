# ==============================================================================
# CLISA DEPLOYMENT - SURGICAL GITIGNORE
# Zero-Secret & Clean Workspace Governance Policy (Linux / Bash / Sway / Hardware)
# ==============================================================================

# Secrets and sensitive environment configurations
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
*.kdbx
*.sqlite
*.sqlite3
*.db

# Credentials & SSH / Hardware tokens
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.token
*.secret

# Logs and runtime artifacts
*.log
logs/
*.pid
*.seed
*.pid.lock

# Shell history & environment traces
*.history
.bash_history
.zsh_history

# Temporary and backup files
tmp/
temp/
*.bak
*.tmp
*.swp
*.swo
*~
.#*

# Build, caches and temporary directories
__pycache__/
*.py[cod]
*$py.class
node_modules/
.pio/
dist/
build/
*.o
*.obj
*.so
*.dylib
*.dll

# OS & Editor debris
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.directory

# Standalone binary downloads
bin/*
!bin/.gitkeep
