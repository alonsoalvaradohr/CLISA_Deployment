# ==============================================================================
# CLISA PARAMETRIC SWAY CONFIGURATION (DYNAMIC FLEXIBLE TOPOLOGY)
# Target: AMD Ryzen 7 7840HS + Radeon 780M / Wayland @ 1920x1200 144Hz
# Dynamic Workspaces // Low Cognitive Latency // Operator-Ready
# ==============================================================================

# Mod Key: Super (Windows key)
set $mod Mod4
set $term alacritty
set $menu rofi -show drun -show-icons

# ------------------------------------------------------------------------------
# 1. DISPLAY & OUTPUTS (SINGLE-HEAD CONSOLIDATED TOPOLOGY)
# ------------------------------------------------------------------------------
output eDP-1 resolution 1920x1200@144Hz position 0 0 adaptive_sync on

# Fallback Generic Rule
output * adaptive_sync on

# ------------------------------------------------------------------------------
# 2. ERGONOMICS & INPUT PERIPHERALS (US INTL & TRACKBALL PRECISION)
# ------------------------------------------------------------------------------
# Keyboard: US International with Dead Keys
input type:keyboard {
    xkb_layout "us"
    xkb_variant "intl"
    xkb_options "caps:escape"
}

# Physical Trackball: Flat acceleration (0 acceleration) & Middle-button Scroll Emulation
input type:pointer {
    accel_profile "flat"
    pointer_accel 0
    scroll_method "on_button_down"
    scroll_button 274
}

# Touchpad
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
}

# ------------------------------------------------------------------------------
# 3. WORKSPACES & CONSOLIDATED OUTPUT BINDINGS (SINGLE-HEAD COLLAPSE)
# ------------------------------------------------------------------------------
set $ws1 "1: DEV"
set $ws2 "2: CAD"
set $ws3 "3: MANUF"
set $ws4 "4: DOC"
set $ws5 "5: SYS"

# Workspace Physical Bindings (Consolidated on eDP-1)
workspace $ws1 output eDP-1
workspace $ws2 output eDP-1
workspace $ws3 output eDP-1
workspace $ws4 output eDP-1
workspace $ws5 output eDP-1

# ------------------------------------------------------------------------------
# 4. AESTHETICS & WINDOW THEMING (GRUVBOX HIGH CONTRAST)
# ------------------------------------------------------------------------------
font pango:JetBrains Mono 10
gaps inner 6
gaps outer 2
default_border pixel 2
default_floating_border pixel 2

client.focused          #83a598 #458588 #ebdbb2 #83a598 #83a598
client.focused_inactive #3c3836 #3c3836 #a89984 #3c3836 #3c3836
client.unfocused        #1d2021 #1d2021 #928374 #1d2021 #1d2021
client.urgent           #fb4934 #cc241d #ebdbb2 #fb4934 #fb4934

# ------------------------------------------------------------------------------
# 5. DYNAMIC WORKSPACE ASSIGNMENTS & TILING ERGONOMICS
# ------------------------------------------------------------------------------
# WS1: DEV (Terminals, IDEs, Core Shell)
assign [app_id="(?i)alacritty"] $ws1
assign [app_id="(?i)foot"] $ws1
assign [app_id="(?i)code"] $ws1
assign [class="(?i)code"] $ws1

# WS2: CAD (FreeCAD, Autodesk Fusion 360, KiCad)
assign [app_id="(?i)org.freecad.FreeCAD"] $ws2
assign [app_id="(?i)freecad"] $ws2
assign [class="(?i)fusion360.exe"] $ws2
assign [app_id="(?i)org.kicad.kicad"] $ws2
assign [app_id="(?i)kicad"] $ws2
assign [class="(?i)kicad"] $ws2

# WS3: MANUF (3D Slicers, Additive Manufacturing)
assign [class="(?i)creality-print"] $ws3
assign [app_id="(?i)creality-print"] $ws3
assign [class="(?i)prusa-slicer"] $ws3
assign [class="(?i)bambu-studio"] $ws3

# WS4: DOC (Scientific Documentation, LaTeX, TeXstudio)
assign [app_id="(?i)texstudio"] $ws4
assign [class="(?i)texstudio"] $ws4
assign [app_id="(?i)org.pwmt.zathura"] $ws4
assign [app_id="(?i)org.kde.okular"] $ws4

# WS5: SYS (MATLAB, Simulink, Telemetry, Signal Analysis, KVM)
assign [class="(?i)matlab"] $ws5
assign [instance="(?i)matlab"] $ws5
assign [app_id="(?i)pulseview"] $ws5
assign [class="(?i)pulseview"] $ws5
assign [app_id="(?i)org.sigrok.PulseView"] $ws5
assign [class="(?i)looking-glass-client"] $ws5
assign [app_id="(?i)looking-glass-client"] $ws5

# ------------------------------------------------------------------------------
# 6. TILING ENFORCEMENT & INTELLIGENT FLOATING EXCEPTIONS (R&D PRESERVATION)
# ------------------------------------------------------------------------------
# Forced Tiling for Primary Workspaces
for_window [app_id="(?i)alacritty"] floating disable
for_window [app_id="(?i)foot"] floating disable
for_window [class="(?i)code"] floating disable
for_window [app_id="(?i)code"] floating disable
for_window [app_id="(?i)texstudio"] floating disable
for_window [app_id="(?i)org.freecad.FreeCAD"] floating disable

# MATLAB Window Management: Main Desk Tiled / Figures & Scopes Floating
for_window [class="(?i)matlab.*" title="^MATLAB.*"] floating disable
for_window [class="(?i)matlab.*" title="^Figure.*"] floating enable
for_window [class="(?i)matlab.*" title="(?i).*scope.*"] floating enable
for_window [class="(?i)matlab.*" window_role="pop-up"] floating enable

# Autodesk Fusion 360: Floating Modals & Preference Windows Preservation
for_window [class="(?i)fusion360.exe" window_type="dialog"] floating enable
for_window [class="(?i)fusion360.exe" window_type="utility"] floating enable
for_window [class="(?i)fusion360.exe" window_type="splash"] floating enable
for_window [class="(?i)fusion360.exe" window_type="menu"] floating enable
for_window [class="(?i)fusion360.exe" title="(?i)open|save|export|preferences|insert|appearance|materials|service utility|command.*"] floating enable

# Universal Modals, Utilities & Hardware Dialogs
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_role="Preferences"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [window_type="utility"] floating enable
for_window [window_type="splash"] floating enable
for_window [window_type="notification"] floating enable

# Hardware & Audio Control Tools
for_window [app_id="(?i)pavucontrol"] floating enable
for_window [app_id="(?i)blueman-manager"] floating enable
for_window [app_id="(?i)nm-connection-editor"] floating enable
for_window [app_id="(?i)org.sigrok.PulseView" title="(?i)connect|device|settings"] floating enable

# ------------------------------------------------------------------------------
# 7. KEYBINDINGS & FAST LAUNCH ARSENAL
# ------------------------------------------------------------------------------
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m "Salir de Sway?" -B "Salir" "swaymsg exit"

# Fast-Launch R&D Arsenal
bindsym $mod+F1 exec code
bindsym $mod+F2 exec ~/.local/bin/freecad
bindsym $mod+F3 exec ~/.local/bin/fusion360-launcher
bindsym $mod+F4 exec ~/.local/bin/creality-print
bindsym $mod+F5 exec texstudio
bindsym $mod+F6 exec ~/.local/bin/clisa-jupyter
bindsym $mod+F7 exec pulseview
bindsym $mod+F8 exec alacritty -e picocom -b 115200 /dev/ttyACM0
bindsym $mod+F9 exec ~/.local/bin/matlab -desktop

# Navigation
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5

# Window Movement & Focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle

# Ergonomic Trackball Multi-Head Fast Transfer
bindsym $mod+Shift+Left move workspace to output left
bindsym $mod+Shift+Right move workspace to output right
bindsym $mod+Shift+Up move workspace to output up
bindsym $mod+Shift+Down move workspace to output down
bindsym $mod+Control+Left move container to output left
bindsym $mod+Control+Right move container to output right
bindsym $mod+Control+Up move container to output up
bindsym $mod+Control+Down move container to output down

# Status Bar
bar {
    swaybar_command waybar
}
